generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb" 
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  nome      String
  email     String     @unique
  senha     String
  role      String     @default("CIDADAO")
  denuncias Denuncia[] @relation("UsuarioDenuncias")
}

model Denuncia {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  descricao      String
  latitude       Float?
  longitude      Float?
  fotoUrl        String?
  endereco       String?
  anonimo        Boolean  @default(false)
  iaSinalizada   Boolean  @default(false)
  criadoEm       DateTime @default(now())
  notaComunidade String?
  notaStatus     String   @default("PENDENTE")
  votosMod       Int      @default(0)

  // O autor da denúncia
  usuarioId      String?  @db.ObjectId
  usuario        Usuario? @relation("UsuarioDenuncias", fields: [usuarioId], references: [id])


  apoios         Int      @default(0)


  apoiadoresIds  String[] @db.ObjectId

  comentarios    Comentario[]
}

// Tipo composto (Embutido) exclusivo do Prisma com MongoDB
type Comentario {
  id        String   @default(uuid())
  texto     String
  criadoEm  DateTime @default(now())
  usuarioId String   @db.ObjectId
}